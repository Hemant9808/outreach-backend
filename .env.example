DATABASE_URL="mysql://root:root@localhost:3306/mail"
PORT=3000
# Used to encrypt SMTP passwords saved in Settings → Email. Changing it invalidates saved passwords.
SETTINGS_SECRET="change-this-to-a-long-random-string"
FRONTEND_URL="http://localhost:5173"
APP_TZ="Asia/Kolkata"

# Secret for the Claude MCP connector (/mcp). Required if the API is reachable from the internet.
MCP_KEY=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
